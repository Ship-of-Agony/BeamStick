<?xml version="1.0" encoding="utf-8"?>
<selector xmlns:android="http://schemas.android.com/apk/res/android">
    <!-- Fokus mit der Beamer-Fernbedienung -->
    <item android:state_focused="true">
        <shape android:shape="rectangle">
            <solid android:color="#26344E" />
            <stroke android:width="3dp" android:color="#4E8CFF" />
            <corners android:radius="16dp" />
        </shape>
    </item>
    <item android:state_pressed="true">
        <shape android:shape="rectangle">
            <solid android:color="#1F2A3F" />
            <stroke android:width="2dp" android:color="#4E8CFF" />
            <corners android:radius="16dp" />
        </shape>
    </item>
    <!-- Ruhezustand -->
    <item>
        <shape android:shape="rectangle">
            <solid android:color="#1E232F" />
            <stroke android:width="1dp" android:color="#2C3446" />
            <corners android:radius="16dp" />
        </shape>
    </item>
</selector>