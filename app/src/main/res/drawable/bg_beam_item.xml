<?xml version="1.0" encoding="utf-8"?>
<selector xmlns:android="http://schemas.android.com/apk/res/android">
    <!-- Zustand: Mit Fernbedienung fokussiert -->
    <item android:state_focused="true">
        <shape android:shape="rectangle">
            <solid android:color="#26334D" />
            <stroke android:width="3dp" android:color="#4E8CFF" />
            <corners android:radius="14dp" />
        </shape>
    </item>
    <!-- Zustand: Angeklickt -->
    <item android:state_pressed="true">
        <shape android:shape="rectangle">
            <solid android:color="#1F2A3F" />
            <stroke android:width="2dp" android:color="#4E8CFF" />
            <corners android:radius="14dp" />
        </shape>
    </item>
    <!-- Standard-Zustand (ruhend) -->
    <item>
        <shape android:shape="rectangle">
            <solid android:color="#161A23" />
            <stroke android:width="1dp" android:color="#242B38" />
            <corners android:radius="14dp" />
        </shape>
    </item>
</selector>